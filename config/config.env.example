# Copy to /etc/nut-ups-shutdown/config.env and edit before activating.
UPS_NAME=local-ups
PRIMARY_HOST=192.0.2.10
ON_BATTERY_DELAY_SECONDS=60
UPS_UNREACHABLE_DELAY_SECONDS=60
SHUTDOWN_STEP_TIMEOUT_SECONDS=180
TEST_MODE=true

# The two consumers shut down together, followed by the storage host.
# Use the same IP addresses or DNS names in the inventory and the order.
SHUTDOWN_TARGETS="192.0.2.21 192.0.2.22 192.0.2.30"
SHUTDOWN_ORDER="192.0.2.21,192.0.2.22 192.0.2.30"
SHUTDOWN_DEPENDENCIES="192.0.2.21>192.0.2.30 192.0.2.22>192.0.2.30"
