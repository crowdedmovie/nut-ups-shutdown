MONITOR @UPS_NAME@@127.0.0.1 1 upsmon_local @NUT_PASSWORD@ primary
MINSUPPLIES 1
RUN_AS_USER nut
POLLFREQ 5
POLLFREQALERT 5
DEADTIME 30
HOSTSYNC 15
FINALDELAY 0
@POWERDOWN_FLAG@
NOTIFYCMD /usr/local/sbin/ups-notify
NOTIFYFLAG ONBATT SYSLOG+EXEC
NOTIFYFLAG ONLINE SYSLOG+EXEC
NOTIFYFLAG COMMBAD SYSLOG+EXEC
NOTIFYFLAG COMMOK SYSLOG+EXEC
NOTIFYFLAG NOCOMM SYSLOG
NOTIFYFLAG LOWBATT SYSLOG
SHUTDOWNCMD "/usr/local/sbin/ups-final-shutdown critical@LOCAL_FALLBACK@"
