#!/bin/sh
set -eu

case "${SSH_ORIGINAL_COMMAND:-}" in
    check)
        /usr/bin/sudo -n -l /usr/bin/systemctl --no-block poweroff >/dev/null
        printf '%s\n' 'ready'
        ;;
    poweroff)
        /usr/bin/sudo -n /usr/bin/systemctl --no-block poweroff
        printf '%s\n' 'shutdown queued'
        ;;
    *)
        printf '%s\n' 'Unsupported UPS shutdown request' >&2
        exit 1
        ;;
esac
