#!/bin/sh
case "${1:-}" in
    onbattery|recovered-battery|commlost)
        reason=$1
        [ "$reason" != recovered-battery ] || reason=onbattery
        if ! /usr/bin/sudo -n /usr/bin/systemctl --no-block start "ups-emergency-shutdown@$reason.service"; then
            logger -t ups-monitor "Failed to queue UPS shutdown verification: $1"
            exit 1
        fi
        ;;
    *)
        logger -t ups-monitor "Unknown UPS event: ${1:-<empty>}"
        exit 1
        ;;
esac
